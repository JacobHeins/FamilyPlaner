# Copy this file to .env and fill in the values before running docker-compose.prod.yml
# chmod 600 .env — ensure only the deploy user can read it

# GitHub repo path used to resolve the image (e.g. myorg/family-planner)
GITHUB_REPOSITORY=

# Tag of the image to deploy (e.g. latest or a specific git sha/semver tag)
IMAGE_TAG=latest

# PostgreSQL
DB_NAME=familyplanner
DB_USERNAME=
DB_PASSWORD=

# JWT — REQUIRED. Base64-encoded HS256 signing secret (min 256-bit / 32 bytes).
# Generate one with: openssl rand -base64 32
JWT_SECRET=
# Token lifetime in milliseconds (optional; defaults to 86400000 = 24h)
JWT_EXPIRATION_MS=86400000
